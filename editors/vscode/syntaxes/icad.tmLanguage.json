{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ICAD",
  "scopeName": "source.icad",
  "patterns": [
    {"include": "#comments"},
    {"include": "#keywords"},
    {"include": "#types"},
    {"include": "#materials"},
    {"include": "#units"},
    {"include": "#numbers"}
  ],
  "repository": {
    "comments": {"patterns": [{"name": "comment.line.number-sign.icad", "match": "#.*$"}]},
    "keywords": {"patterns": [{"name": "keyword.control.icad", "match": "\\b(PROJECT|IMPORT|INJECT|UNITS|TOLERANCE|LINEAR|ANGULAR|PARAMETER|ANGLE|POINT3|VECTOR|POSE|INSTANCE|JOINT|MATERIAL|PRESET|BASE_COLOR|METALLIC|ROUGHNESS|TEXTURE_SCALE|UV_MODE|PROFILE|TARGET_PROFILE|SKETCH|BODY|FEATURE|CONSTRAINT|MATE|SCENE|TRACK|KEYFRAME|END|TYPE|OPERATION|POSITION|ROTATION|VALUE|LIMIT|BACKGROUND|DURATION|FPS|LOOP|LIGHT|COLOR|INTENSITY|EVENT|EASING|VISIBLE|AT|OF|FROM|TO|ALONG|DISTANCE|AROUND|BY|AXIS|SELECT|NEAREST|PATH|DIRECTION|COUNT|PLANE|NORMAL|CENTER|OFFSET|SECTION)\\b"}]},
    "types": {"patterns": [{"name": "support.type.icad", "match": "\\b(BOX|CYLINDER|CONE|SPHERE|EXTRUDE|REVOLVE|SWEEP|LOFT|FREEFORM|UNION|CUT|INTERSECT|NEW|FIXED|REVOLUTE|PRISMATIC|BODY|CAMERA|JOINT|VISIBILITY|FACE|EDGE|POINT|START|LINE|ARC|CIRCLE|CLOSE|CW|CCW|PLANAR|CYLINDRICAL|SPHERICAL|MIN_DISTANCE|COINCIDENT|PARALLEL|PERPENDICULAR|ANGLE_BETWEEN|HORIZONTAL|VERTICAL|DIRECTIONAL|EASE_IN|EASE_OUT|EASE_IN_OUT|STEP|ON|OFF)\\b"}]},
    "materials": {"patterns": [{"name": "constant.language.material.icad", "match": "\\b(CONCRETE|STRUCTURAL_STEEL|ALUMINUM|ASPHALT|GLASS|WOOD|BRICK|GRANITE|MARBLE|COPPER|BRASS|TITANIUM|CHROME|RUSTED_STEEL|RUBBER|PLASTIC|CARBON_FIBER|CERAMIC|PLASTER|FABRIC|LEATHER|EARTH|GRASS|WATER|ICE|EMISSIVE_WHITE)\\b"}]},
    "units": {"patterns": [{"name": "constant.language.unit.icad", "match": "\\b(mm|cm|m|in|deg|rad|s|ms)\\b"}]},
    "numbers": {"patterns": [{"name": "constant.numeric.icad", "match": "(?<![A-Za-z_])[-+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][-+]?\\d+)?"}]}
  }
}
