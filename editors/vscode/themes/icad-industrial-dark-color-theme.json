{
  "$schema": "vscode://schemas/color-theme",
  "name": "ICAD Industrial Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#0C111B",
    "editor.foreground": "#D7E0EE",
    "editorLineNumber.foreground": "#46546B",
    "editorLineNumber.activeForeground": "#9FB1CC",
    "editorCursor.foreground": "#FFCC66",
    "editor.selectionBackground": "#27466D99",
    "editor.inactiveSelectionBackground": "#1C334F88",
    "editorIndentGuide.background1": "#1A2638",
    "editorIndentGuide.activeBackground1": "#405879",
    "editorError.foreground": "#FF6B81",
    "editorWarning.foreground": "#FFC857",
    "editorInfo.foreground": "#55C2FF",
    "editorHint.foreground": "#7DD3A7"
  },
  "tokenColors": [
    {"scope": ["comment.line.number-sign.icad"], "settings": {"foreground": "#718096", "fontStyle": "italic"}},
    {"scope": ["keyword.control.icad"], "settings": {"foreground": "#C792EA", "fontStyle": "bold"}},
    {"scope": ["storage.type.parameter.icad"], "settings": {"foreground": "#FFCB6B", "fontStyle": "bold"}},
    {"scope": ["variable.other.parameter.definition.icad"], "settings": {"foreground": "#FFE6A7", "fontStyle": "italic"}},
    {"scope": ["keyword.declaration.point.icad", "keyword.declaration.spatial.icad"], "settings": {"foreground": "#5DE4C7", "fontStyle": "bold"}},
    {"scope": ["entity.name.point.icad", "entity.name.spatial.icad"], "settings": {"foreground": "#9EF4E3"}},
    {"scope": ["keyword.declaration.line.icad"], "settings": {"foreground": "#58A6FF", "fontStyle": "bold"}},
    {"scope": ["entity.name.line.icad"], "settings": {"foreground": "#9DCAFF"}},
    {"scope": ["keyword.declaration.curve.icad"], "settings": {"foreground": "#FF8FB3", "fontStyle": "bold"}},
    {"scope": ["entity.name.curve.icad"], "settings": {"foreground": "#FFC1D5"}},
    {"scope": ["support.type.surface.operation.icad", "support.type.surface.selector.icad"], "settings": {"foreground": "#F78C6C", "fontStyle": "bold"}},
    {"scope": ["keyword.declaration.object.icad"], "settings": {"foreground": "#82AAFF", "fontStyle": "bold"}},
    {"scope": ["entity.name.object.icad"], "settings": {"foreground": "#B4C9FF"}},
    {"scope": ["keyword.declaration.scene.icad", "keyword.declaration.event.icad", "keyword.control.animation.icad"], "settings": {"foreground": "#C3E88D", "fontStyle": "bold"}},
    {"scope": ["entity.name.scene.icad", "entity.name.event.icad"], "settings": {"foreground": "#E0F5B8"}},
    {"scope": ["keyword.declaration.material.icad", "constant.language.material.icad"], "settings": {"foreground": "#FFD580", "fontStyle": "bold"}},
    {"scope": ["entity.name.material.icad"], "settings": {"foreground": "#FFE7B5"}},
    {"scope": ["keyword.declaration.constraint.icad", "support.type.constraint.icad"], "settings": {"foreground": "#BB9AF7", "fontStyle": "bold"}},
    {"scope": ["entity.name.constraint.icad"], "settings": {"foreground": "#D8C7FF"}},
    {"scope": ["support.type.primitive.icad", "support.type.operation.icad", "support.type.assembly.icad", "support.type.sketch.icad", "support.type.animation.icad"], "settings": {"foreground": "#89DDFF"}},
    {"scope": ["constant.numeric.icad", "constant.numeric.time.icad"], "settings": {"foreground": "#F6C177"}},
    {"scope": ["constant.language.unit.icad"], "settings": {"foreground": "#A6E3A1", "fontStyle": "italic"}},
    {"scope": ["string.quoted.double.icad"], "settings": {"foreground": "#A6E3A1"}},
    {"scope": ["keyword.operator.arithmetic.icad", "punctuation.accessor.icad", "punctuation.section.parens.icad"], "settings": {"foreground": "#89DDFF"}}
  ]
}
