# ICAD industrial articulated robot rebuilt from a single coherent datum chain.
# Every link outline physically overlaps both pivots that define its joint span.
REQUIRES ICAD 1.0
REQUIRES CAPABILITY MANUFACTURING_CONNECTIONS_V1
REQUIRES CAPABILITY MAGNETIC_INTERFACE_SNAP_V1
PROJECT robotic_arm
UNITS mm

PARAMETER base_radius 75 mm
PARAMETER column_radius 55 mm
PARAMETER major_joint_radius 30 mm
PARAMETER elbow_joint_radius 25 mm
PARAMETER wrist_joint_radius 20 mm
PARAMETER arm_depth 32 mm
PARAMETER jaw_depth 14 mm

ANGLE home_angle 0 deg

POINT3 world_origin 0 mm 0 mm 0 mm
POINT3 waist_center 0 mm 0 mm 75 mm
POINT3 shoulder_center 0 mm 0 mm 150 mm
POINT3 elbow_center -70 mm 0 mm 275 mm
POINT3 wrist_center 75 mm 0 mm 250 mm
POINT3 palm_center 145 mm 0 mm 225 mm
POINT3 upper_jaw_pivot 180 mm 0 mm 241 mm
POINT3 lower_jaw_pivot 180 mm 0 mm 209 mm
POINT3 drive_gear_center 164 mm 27 mm 233 mm
POINT3 follower_gear_center 164 mm 27 mm 207 mm
POINT3 tool_center 250 mm 0 mm 225 mm
POINT3 tool_target 250 mm 0 mm 225 mm

VECTOR x_axis 1 0 0
VECTOR y_axis 0 1 0
VECTOR z_axis 0 0 1
VECTOR upper_arm_axis FROM shoulder_center TO elbow_center
VECTOR forearm_axis FROM elbow_center TO wrist_center
VECTOR wrist_axis FROM wrist_center TO palm_center
VECTOR tool_axis FROM palm_center TO tool_center

MATERIAL blue_shell
PRESET PLASTIC
BASE_COLOR 0.035 0.19 0.62 1
METALLIC 0.35
ROUGHNESS 0.28
TEXTURE_SCALE 18 mm
UV_MODE BOX
END
MATERIAL steel_joint STRUCTURAL_STEEL
MATERIAL dark_grip CARBON_FIBER

# Front-view outlines use world X and Z as profile X and Y. ROTATION_X 90 deg
# maps profile Y to world Z and centers the extrusion across world Y.
PROFILE upper_arm_outline
START -24 mm 137 mm
LINE -8 mm 125 mm
LINE 13 mm 136 mm
LINE -47 mm 249 mm
LINE -48 mm 270 mm
LINE -62 mm 293 mm
LINE -83 mm 294 mm
LINE -97 mm 276 mm
LINE -89 mm 255 mm
LINE -22 mm 143 mm
CLOSE
END

PROFILE forearm_outline
START -86 mm 254 mm
LINE -76 mm 245 mm
LINE -57 mm 251 mm
LINE 52 mm 232 mm
LINE 79 mm 229 mm
LINE 96 mm 243 mm
LINE 92 mm 263 mm
LINE 78 mm 273 mm
LINE 55 mm 269 mm
LINE -56 mm 288 mm
LINE -78 mm 289 mm
LINE -91 mm 276 mm
CLOSE
END

PROFILE wrist_outline
START 57 mm 237 mm
LINE 68 mm 228 mm
LINE 84 mm 231 mm
LINE 132 mm 213 mm
LINE 151 mm 207 mm
LINE 165 mm 217 mm
LINE 162 mm 235 mm
LINE 151 mm 243 mm
LINE 135 mm 241 mm
LINE 83 mm 261 mm
LINE 66 mm 263 mm
LINE 55 mm 253 mm
CLOSE
END

PROFILE upper_jaw_outline
START 171 mm 232 mm
LINE 184 mm 232 mm
LINE 201 mm 236 mm
LINE 232 mm 240 mm
LINE 248 mm 238 mm
LINE 258 mm 236 mm
LINE 250 mm 248 mm
LINE 238 mm 252 mm
LINE 208 mm 248 mm
LINE 184 mm 244 mm
LINE 171 mm 248 mm
CLOSE
END

PROFILE lower_jaw_outline
START 171 mm 218 mm
LINE 181 mm 222 mm
LINE 199 mm 216 mm
LINE 229 mm 212 mm
LINE 241 mm 215 mm
LINE 240 mm 224 mm
LINE 247 mm 231 mm
LINE 255 mm 226 mm
LINE 257 mm 216 mm
LINE 248 mm 207 mm
LINE 232 mm 204 mm
LINE 201 mm 208 mm
LINE 184 mm 213 mm
LINE 171 mm 210 mm
CLOSE
END

PROFILE drive_gear_teeth
START 14 mm 0 mm
LINE 11.09 mm 2.97 mm
LINE 12.12 mm 7 mm
LINE 8.13 mm 8.13 mm
LINE 7 mm 12.12 mm
LINE 2.97 mm 11.09 mm
LINE 0 mm 14 mm
LINE -2.97 mm 11.09 mm
LINE -7 mm 12.12 mm
LINE -8.13 mm 8.13 mm
LINE -12.12 mm 7 mm
LINE -11.09 mm 2.97 mm
LINE -14 mm 0 mm
LINE -11.09 mm -2.97 mm
LINE -12.12 mm -7 mm
LINE -8.13 mm -8.13 mm
LINE -7 mm -12.12 mm
LINE -2.97 mm -11.09 mm
LINE 0 mm -14 mm
LINE 2.97 mm -11.09 mm
LINE 7 mm -12.12 mm
LINE 8.13 mm -8.13 mm
LINE 12.12 mm -7 mm
LINE 11.09 mm -2.97 mm
CLOSE
END

PROFILE follower_gear_teeth
START 12 mm 0 mm
LINE 9.66 mm 2.59 mm
LINE 10.39 mm 6 mm
LINE 7.07 mm 7.07 mm
LINE 6 mm 10.39 mm
LINE 2.59 mm 9.66 mm
LINE 0 mm 12 mm
LINE -2.59 mm 9.66 mm
LINE -6 mm 10.39 mm
LINE -7.07 mm 7.07 mm
LINE -10.39 mm 6 mm
LINE -9.66 mm 2.59 mm
LINE -12 mm 0 mm
LINE -9.66 mm -2.59 mm
LINE -10.39 mm -6 mm
LINE -7.07 mm -7.07 mm
LINE -6 mm -10.39 mm
LINE -2.59 mm -9.66 mm
LINE 0 mm -12 mm
LINE 2.59 mm -9.66 mm
LINE 6 mm -10.39 mm
LINE 7.07 mm -7.07 mm
LINE 10.39 mm -6 mm
LINE 9.66 mm -2.59 mm
CLOSE
END

BODY base
MATERIAL steel_joint
FEATURE mounting_flange
TYPE CYLINDER
RADIUS base_radius
HEIGHT 12 mm
END
FEATURE column
TYPE CYLINDER
RADIUS column_radius
HEIGHT 63 mm
ORIGIN_Z 12 mm
END
FEATURE bolt_front
TYPE CYLINDER
RADIUS 4 mm
HEIGHT 8 mm
ORIGIN_X 55 mm
ORIGIN_Z 4 mm
END
FEATURE bolt_back
TYPE CYLINDER
RADIUS 4 mm
HEIGHT 8 mm
ORIGIN_X -55 mm
ORIGIN_Z 4 mm
END
FEATURE bolt_left
TYPE CYLINDER
RADIUS 4 mm
HEIGHT 8 mm
ORIGIN_Y 55 mm
ORIGIN_Z 4 mm
END
FEATURE bolt_right
TYPE CYLINDER
RADIUS 4 mm
HEIGHT 8 mm
ORIGIN_Y -55 mm
ORIGIN_Z 4 mm
END
END

BODY waist
MATERIAL blue_shell
FEATURE turntable
TYPE CYLINDER
RADIUS 50 mm
HEIGHT 20 mm
ORIGIN_Z 75 mm
END
FEATURE shoulder_pedestal
TYPE BOX
WIDTH 70 mm
DEPTH 66 mm
HEIGHT 70 mm
ORIGIN_X -35 mm
ORIGIN_Y -33 mm
ORIGIN_Z 90 mm
END
FEATURE shoulder_back
TYPE BOX
WIDTH 52 mm
DEPTH 76 mm
HEIGHT 42 mm
ORIGIN_X -26 mm
ORIGIN_Y -38 mm
ORIGIN_Z 142 mm
END
END

BODY upper_arm
MATERIAL blue_shell
FEATURE shoulder_joint
TYPE CYLINDER
RADIUS major_joint_radius
HEIGHT arm_depth
ORIGIN_Y 16 mm
ORIGIN_Z 150 mm
ROTATION_X 90 deg
END
FEATURE upper_arm_shell
TYPE EXTRUDE
PROFILE upper_arm_outline
HEIGHT arm_depth
ORIGIN_Y 16 mm
ROTATION_X 90 deg
END
END

BODY forearm
MATERIAL blue_shell
FEATURE elbow_joint
TYPE CYLINDER
RADIUS elbow_joint_radius
HEIGHT arm_depth
ORIGIN_X -70 mm
ORIGIN_Y 16 mm
ORIGIN_Z 275 mm
ROTATION_X 90 deg
END
FEATURE forearm_shell
TYPE EXTRUDE
PROFILE forearm_outline
HEIGHT arm_depth
ORIGIN_Y 16 mm
ROTATION_X 90 deg
END
END

BODY wrist
MATERIAL blue_shell
FEATURE wrist_joint
TYPE CYLINDER
RADIUS wrist_joint_radius
HEIGHT 28 mm
ORIGIN_X 75 mm
ORIGIN_Y 14 mm
ORIGIN_Z 250 mm
ROTATION_X 90 deg
END
FEATURE wrist_shell
TYPE EXTRUDE
PROFILE wrist_outline
HEIGHT 28 mm
ORIGIN_Y 14 mm
ROTATION_X 90 deg
END
END

BODY palm
MATERIAL steel_joint
FEATURE palm_housing
TYPE BOX
WIDTH 52 mm
DEPTH 34 mm
HEIGHT 54 mm
ORIGIN_X 136 mm
ORIGIN_Y -17 mm
ORIGIN_Z 198 mm
END
FEATURE tool_mount
TYPE CYLINDER
RADIUS 17 mm
HEIGHT 28 mm
ORIGIN_X 145 mm
ORIGIN_Y 14 mm
ORIGIN_Z 225 mm
ROTATION_X 90 deg
END
FEATURE drive_bearing_boss
TYPE CYLINDER
RADIUS 7 mm
HEIGHT 10 mm
ORIGIN_X 164 mm
ORIGIN_Y 27 mm
ORIGIN_Z 233 mm
ROTATION_X 90 deg
END
FEATURE follower_bearing_boss
TYPE CYLINDER
RADIUS 7 mm
HEIGHT 10 mm
ORIGIN_X 164 mm
ORIGIN_Y 27 mm
ORIGIN_Z 207 mm
ROTATION_X 90 deg
END
END

BODY upper_jaw
MATERIAL dark_grip
FEATURE upper_jaw_plate
TYPE EXTRUDE
PROFILE upper_jaw_outline
HEIGHT jaw_depth
ORIGIN_Y 7 mm
ROTATION_X 90 deg
END
FEATURE upper_jaw_pin
TYPE CYLINDER
RADIUS 10 mm
HEIGHT 20 mm
ORIGIN_X 180 mm
ORIGIN_Y 10 mm
ORIGIN_Z 241 mm
ROTATION_X 90 deg
END
END

BODY lower_jaw
MATERIAL dark_grip
FEATURE lower_jaw_plate
TYPE EXTRUDE
PROFILE lower_jaw_outline
HEIGHT jaw_depth
ORIGIN_Y 7 mm
ROTATION_X 90 deg
END
FEATURE lower_jaw_pin
TYPE CYLINDER
RADIUS 10 mm
HEIGHT 20 mm
ORIGIN_X 180 mm
ORIGIN_Y 10 mm
ORIGIN_Z 209 mm
ROTATION_X 90 deg
END
END

BODY drive_gear
MATERIAL steel_joint
FEATURE drive_teeth
TYPE EXTRUDE
PROFILE drive_gear_teeth
HEIGHT 10 mm
ORIGIN_X 164 mm
ORIGIN_Y 37 mm
ORIGIN_Z 233 mm
ROTATION_X 90 deg
END
FEATURE drive_hub
TYPE CYLINDER
RADIUS 5 mm
HEIGHT 10 mm
ORIGIN_X 164 mm
ORIGIN_Y 37 mm
ORIGIN_Z 233 mm
ROTATION_X 90 deg
END
END

BODY follower_gear
MATERIAL steel_joint
FEATURE follower_teeth
TYPE EXTRUDE
PROFILE follower_gear_teeth
HEIGHT 10 mm
ORIGIN_X 164 mm
ORIGIN_Y 37 mm
ORIGIN_Z 207 mm
ROTATION_X 90 deg
END
FEATURE follower_hub
TYPE CYLINDER
RADIUS 5 mm
HEIGHT 10 mm
ORIGIN_X 164 mm
ORIGIN_Y 37 mm
ORIGIN_Z 207 mm
ROTATION_X 90 deg
END
END

POSE base AT world_origin ROTATION home_angle home_angle home_angle

JOINT base_mount FIXED WORLD base AT world_origin AXIS z_axis
JOINT waist_turn REVOLUTE base waist AT waist_center AXIS z_axis VALUE home_angle LIMIT -180 deg 180 deg
JOINT shoulder_hinge REVOLUTE waist upper_arm AT shoulder_center AXIS y_axis VALUE home_angle LIMIT -75 deg 75 deg
JOINT elbow_hinge REVOLUTE upper_arm forearm AT elbow_center AXIS y_axis VALUE home_angle LIMIT -120 deg 120 deg
JOINT wrist_pitch REVOLUTE forearm wrist AT wrist_center AXIS y_axis VALUE home_angle LIMIT -100 deg 100 deg
JOINT wrist_roll REVOLUTE wrist palm AT palm_center AXIS wrist_axis VALUE home_angle LIMIT -180 deg 180 deg
JOINT upper_jaw_hinge REVOLUTE palm upper_jaw AT upper_jaw_pivot AXIS y_axis VALUE home_angle LIMIT 0 deg 25 deg
JOINT lower_jaw_hinge REVOLUTE palm lower_jaw AT lower_jaw_pivot AXIS y_axis VALUE home_angle LIMIT -25 deg 0 deg
JOINT drive_gear_joint REVOLUTE palm drive_gear AT drive_gear_center AXIS y_axis VALUE home_angle LIMIT -180 deg 180 deg
JOINT follower_gear_joint REVOLUTE palm follower_gear AT follower_gear_center AXIS y_axis VALUE home_angle LIMIT -180 deg 180 deg

# Physical connection contracts complement the kinematic joints. Each bearing
# seat is validated at the same named pivot used by the corresponding joint.
INTERFACE base_waist_shaft BODY base AT waist_center AXIS z_axis TYPE SHAFT SIZE 50 mm
INTERFACE waist_base_bearing BODY waist AT waist_center AXIS z_axis TYPE BEARING_SEAT SIZE 50 mm
CONNECT waist_bearing base_waist_shaft waist_base_bearing METHOD BEARING STANDARD ISO_492 FIT H7_g6 CLEARANCE 0.02 mm AUTO

INTERFACE waist_shoulder_shaft BODY waist AT shoulder_center AXIS y_axis TYPE SHAFT SIZE 30 mm
INTERFACE upper_arm_shoulder_bearing BODY upper_arm AT shoulder_center AXIS y_axis TYPE BEARING_SEAT SIZE 30 mm
CONNECT shoulder_bearing waist_shoulder_shaft upper_arm_shoulder_bearing METHOD BEARING STANDARD ISO_492 FIT H7_g6 CLEARANCE 0.02 mm AUTO

INTERFACE upper_arm_elbow_shaft BODY upper_arm AT elbow_center AXIS y_axis TYPE SHAFT SIZE 25 mm
INTERFACE forearm_elbow_bearing BODY forearm AT elbow_center AXIS y_axis TYPE BEARING_SEAT SIZE 25 mm
CONNECT elbow_bearing upper_arm_elbow_shaft forearm_elbow_bearing METHOD BEARING STANDARD ISO_492 FIT H7_g6 CLEARANCE 0.02 mm AUTO

INTERFACE forearm_wrist_shaft BODY forearm AT wrist_center AXIS y_axis TYPE SHAFT SIZE 20 mm
INTERFACE wrist_pitch_bearing BODY wrist AT wrist_center AXIS y_axis TYPE BEARING_SEAT SIZE 20 mm
CONNECT wrist_pitch_bearing_connection forearm_wrist_shaft wrist_pitch_bearing METHOD BEARING STANDARD ISO_492 FIT H7_g6 CLEARANCE 0.02 mm AUTO

INTERFACE wrist_roll_shaft BODY wrist AT palm_center AXIS wrist_axis TYPE SHAFT SIZE 17 mm
INTERFACE palm_roll_bearing BODY palm AT palm_center AXIS wrist_axis TYPE BEARING_SEAT SIZE 17 mm
CONNECT wrist_roll_bearing_connection wrist_roll_shaft palm_roll_bearing METHOD BEARING STANDARD ISO_492 FIT H7_g6 CLEARANCE 0.02 mm AUTO

INTERFACE palm_upper_jaw_pin BODY palm AT upper_jaw_pivot AXIS y_axis TYPE PIN SIZE 10 mm
INTERFACE upper_jaw_pivot_hole BODY upper_jaw AT upper_jaw_pivot AXIS y_axis TYPE HOLE SIZE 10 mm
CONNECT upper_jaw_pin_connection palm_upper_jaw_pin upper_jaw_pivot_hole METHOD PINNED STANDARD ISO_8734 FASTENER PIN_10 CLEARANCE 0.02 mm AUTO

INTERFACE palm_lower_jaw_pin BODY palm AT lower_jaw_pivot AXIS y_axis TYPE PIN SIZE 10 mm
INTERFACE lower_jaw_pivot_hole BODY lower_jaw AT lower_jaw_pivot AXIS y_axis TYPE HOLE SIZE 10 mm
CONNECT lower_jaw_pin_connection palm_lower_jaw_pin lower_jaw_pivot_hole METHOD PINNED STANDARD ISO_8734 FASTENER PIN_10 CLEARANCE 0.02 mm AUTO

INTERFACE palm_drive_shaft BODY palm AT drive_gear_center AXIS y_axis TYPE SHAFT SIZE 5 mm
INTERFACE drive_gear_bearing BODY drive_gear AT drive_gear_center AXIS y_axis TYPE BEARING_SEAT SIZE 5 mm
CONNECT drive_gear_bearing_connection palm_drive_shaft drive_gear_bearing METHOD BEARING STANDARD ISO_492 FIT H7_g6 CLEARANCE 0.02 mm AUTO

INTERFACE palm_follower_shaft BODY palm AT follower_gear_center AXIS y_axis TYPE SHAFT SIZE 5 mm
INTERFACE follower_gear_bearing BODY follower_gear AT follower_gear_center AXIS y_axis TYPE BEARING_SEAT SIZE 5 mm
CONNECT follower_gear_bearing_connection palm_follower_shaft follower_gear_bearing METHOD BEARING STANDARD ISO_492 FIT H7_g6 CLEARANCE 0.02 mm AUTO

CONSTRAINT tool_axis_defined PARALLEL tool_axis tool_axis
CONSTRAINT joint_plane PERPENDICULAR y_axis z_axis
CONSTRAINT tool_on_target COINCIDENT tool_center tool_target 0.01 mm

SCENE articulation
DURATION 8 s
FPS 30
BACKGROUND STUDIO
TRACK waist_motion JOINT waist_turn
EASING EASE_IN_OUT
KEYFRAME 0 s VALUE 0 deg
KEYFRAME 4 s VALUE 30 deg
KEYFRAME 8 s VALUE 0 deg
END
TRACK shoulder_motion JOINT shoulder_hinge
EASING EASE_IN_OUT
KEYFRAME 0 s VALUE 0 deg
KEYFRAME 4 s VALUE 18 deg
KEYFRAME 8 s VALUE 0 deg
END
TRACK elbow_motion JOINT elbow_hinge
EASING EASE_IN_OUT
KEYFRAME 0 s VALUE 0 deg
KEYFRAME 4 s VALUE -28 deg
KEYFRAME 8 s VALUE 0 deg
END
TRACK wrist_pitch_motion JOINT wrist_pitch
EASING EASE_IN_OUT
KEYFRAME 0 s VALUE 0 deg
KEYFRAME 4 s VALUE 24 deg
KEYFRAME 8 s VALUE 0 deg
END
TRACK wrist_roll_motion JOINT wrist_roll
EASING EASE_IN_OUT
KEYFRAME 0 s VALUE 0 deg
KEYFRAME 4 s VALUE 90 deg
KEYFRAME 8 s VALUE 0 deg
END
TRACK upper_jaw_motion JOINT upper_jaw_hinge
EASING EASE_IN_OUT
KEYFRAME 0 s VALUE 0 deg
KEYFRAME 4 s VALUE 16 deg
KEYFRAME 8 s VALUE 0 deg
END
TRACK lower_jaw_motion JOINT lower_jaw_hinge
EASING EASE_IN_OUT
KEYFRAME 0 s VALUE 0 deg
KEYFRAME 4 s VALUE -16 deg
KEYFRAME 8 s VALUE 0 deg
END
TRACK drive_gear_motion JOINT drive_gear_joint
EASING EASE_IN_OUT
KEYFRAME 0 s VALUE 0 deg
KEYFRAME 4 s VALUE 90 deg
KEYFRAME 8 s VALUE 0 deg
END
TRACK follower_gear_motion JOINT follower_gear_joint
EASING EASE_IN_OUT
KEYFRAME 0 s VALUE 0 deg
KEYFRAME 4 s VALUE -90 deg
KEYFRAME 8 s VALUE 0 deg
END
END
