# End-to-end ICAD acceptance model: a 120 metre twin-pier bridge.
PROJECT advanced_bridge
UNITS mm

PARAMETER bridge_length 120 m
PARAMETER bridge_width 20 m
PARAMETER deck_elevation 18 m
PARAMETER deck_thickness 1 m
PARAMETER tower_height 22 m
PARAMETER pier_radius 2500 mm
POINT3 inspection_light 60000 mm 10000 mm 42000 mm

# Predefined PBR materials include deterministic embedded procedural textures.
MATERIAL bridge_concrete
PRESET CONCRETE
ROUGHNESS 0.9
TEXTURE_SCALE 800 mm
UV_MODE BOX
END
MATERIAL bridge_steel STRUCTURAL_STEEL
MATERIAL road_surface ASPHALT

# Foundations, abutments, and four load-bearing piers.
BODY substructure
MATERIAL bridge_concrete
FEATURE west_abutment
TYPE BOX
WIDTH 6000 mm
DEPTH 20000 mm
HEIGHT 8000 mm
ORIGIN_X 0 mm
ORIGIN_Y 0 mm
ORIGIN_Z 0 mm
END
FEATURE east_abutment
TYPE BOX
WIDTH 6000 mm
DEPTH 20000 mm
HEIGHT 8000 mm
ORIGIN_X 114000 mm
ORIGIN_Y 0 mm
ORIGIN_Z 0 mm
END
FEATURE west_pier_north
TYPE CYLINDER
RADIUS 2500 mm
HEIGHT 18000 mm
ORIGIN_X 30000 mm
ORIGIN_Y 5000 mm
ORIGIN_Z 0 mm
END
FEATURE west_pier_south
TYPE CYLINDER
RADIUS 2500 mm
HEIGHT 18000 mm
ORIGIN_X 30000 mm
ORIGIN_Y 15000 mm
ORIGIN_Z 0 mm
END
FEATURE east_pier_north
TYPE CYLINDER
RADIUS 2500 mm
HEIGHT 18000 mm
ORIGIN_X 90000 mm
ORIGIN_Y 5000 mm
ORIGIN_Z 0 mm
END
FEATURE east_pier_south
TYPE CYLINDER
RADIUS 2500 mm
HEIGHT 18000 mm
ORIGIN_X 90000 mm
ORIGIN_Y 15000 mm
ORIGIN_Z 0 mm
END
END

